# Kalshi Trading Bot Configuration

# Kalshi API
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2

# Auth option 1: email/password
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password_here

# Auth option 2: API key (RSA) — alternative to email/password
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PATH=

# === Capital Allocation ===
SHORT_TERM_ALLOCATION=0.90
LONG_TERM_ALLOCATION=0.10

# === Short-Term Strategy (Scalping) ===
ST_MIN_PROBABILITY=0.85
ST_MOMENTUM_PROBABILITY=0.80
ST_MAX_PRICE=95
ST_MIN_VOLUME=5000
ST_MAX_HOURS_TO_CLOSE=24
ST_IDEAL_HOURS_TO_CLOSE=12
ST_POSITION_SIZE_PCT=0.25
ST_MAX_CONCURRENT=4
ST_MAX_CAPITAL_DEPLOYED=0.60
ST_TARGET_PROFIT_PCT=0.05
ST_STOP_LOSS_PCT=0.05
ST_STALE_MINUTES=45

# === Long-Term Strategy (Holds) ===
LT_MIN_PROBABILITY=0.90
LT_MIN_DAYS_TO_CLOSE=30
LT_MAX_DAYS_TO_CLOSE=60
LT_MAX_POSITIONS=3
LT_MIN_PRICE=85
LT_MAX_PRICE=95
LT_EXIT_PRICE=97

# === Hot State (Adaptive Mode) ===
HOT_STATE_TRIGGER_PCT=0.10
HOT_STATE_MAX_TRIGGER_PCT=0.25
HOT_STATE_POSITION_SIZE_PCT=0.60
HOT_STATE_MIN_PROBABILITY=0.88
HOT_STATE_TARGET_PROFIT_PCT=0.025

# === Kill Switch ===
KILL_SWITCH_DRAWDOWN_PCT=0.05

# === Trade Limits ===
MAX_TRADES_PER_DAY=10
DEFAULT_ORDER_SIZE=10
MAX_ORDER_SIZE=100
MIN_PROBABILITY=0.80
