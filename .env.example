# Kalshi Trading Bot Configuration

# Kalshi API
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2

# Auth option 1: email/password
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password_here

# Auth option 2: API key (RSA) — alternative to email/password
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PATH=

# Trading settings
DEFAULT_ORDER_SIZE=10
MAX_ORDER_SIZE=100

# Minimum probability threshold (0.80 = 80%)
MIN_PROBABILITY=0.80
